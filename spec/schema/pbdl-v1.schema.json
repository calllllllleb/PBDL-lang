{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "VersionToken": {
      "title": "PBDL VersionToken",
      "type": "string",
      "const": "1.0"
    },
    "EntityId": {
      "title": "PBDL EntityId",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9._-]*$"
    },
    "Text": {
      "title": "PBDL Text",
      "type": "string",
      "pattern": "^(?s:.*\\S.*)$"
    }
  }
}
