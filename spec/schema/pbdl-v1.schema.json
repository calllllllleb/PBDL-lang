{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "VersionToken": {
      "title": "PBDL VersionToken",
      "type": "string",
      "const": "1.0"
    },
    "EntityId": {
      "title": "PBDL EntityId",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9._-]*$"
    },
    "Text": {
      "title": "PBDL Text",
      "type": "string",
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "Coding": {
      "title": "PBDL Coding",
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "code": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "version": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "display": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "unevaluatedProperties": false
    },
    "Confidence": {
      "title": "PBDL Confidence",
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "metric": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "scale": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "value",
        "metric"
      ],
      "unevaluatedProperties": false
    }
  }
}
