{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "VersionToken": {
      "title": "PBDL VersionToken",
      "type": "string",
      "const": "1.0"
    },
    "EntityId": {
      "title": "PBDL EntityId",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9._-]*$"
    },
    "Text": {
      "title": "PBDL Text",
      "type": "string",
      "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "Coding": {
      "title": "PBDL Coding",
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "code": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "version": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "display": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "unevaluatedProperties": false
    },
    "Confidence": {
      "title": "PBDL Confidence",
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "metric": {
          "type": "string",
          "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
        },
        "scale": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "unevaluatedProperties": false
        }
      },
      "required": [
        "value",
        "metric"
      ],
      "unevaluatedProperties": false
    },
    "TemporalValue": {
      "title": "PBDL TemporalValue",
      "type": "string",
      "oneOf": [
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})$(?![\\u000A\\u000D\\u2028\\u2029])"
        },
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])$(?![\\u000A\\u000D\\u2028\\u2029])"
        },
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$(?![\\u000A\\u000D\\u2028\\u2029])"
        },
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9](?:Z(?:\\[[A-Za-z0-9._+/-]+\\])?|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)(?:\\[[A-Za-z0-9._+/-]+\\])?|\\[[A-Za-z0-9._+/-]+\\])?$(?![\\u000A\\u000D\\u2028\\u2029])"
        },
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:Z(?:\\[[A-Za-z0-9._+/-]+\\])?|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)(?:\\[[A-Za-z0-9._+/-]+\\])?|\\[[A-Za-z0-9._+/-]+\\])?$(?![\\u000A\\u000D\\u2028\\u2029])"
        },
        {
          "pattern": "^(?:000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{1,9}(?:Z(?:\\[[A-Za-z0-9._+/-]+\\])?|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00)(?:\\[[A-Za-z0-9._+/-]+\\])?|\\[[A-Za-z0-9._+/-]+\\])?$(?![\\u000A\\u000D\\u2028\\u2029])"
        }
      ]
    },
    "SubjectRef": {
      "title": "PBDL SubjectRef",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "ref"
      ],
      "unevaluatedProperties": false
    },
    "CoreEntityRef": {
      "title": "PBDL CoreEntityRef",
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "required": [
        "ref"
      ],
      "unevaluatedProperties": false
    },
    "ExternalActorRef": {
      "title": "PBDL ExternalActorRef",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "person",
            "device",
            "software",
            "other"
          ]
        },
        "external_id": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
            },
            "value": {
              "type": "string",
              "pattern": "[^\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
            }
          },
          "required": [
            "system",
            "value"
          ],
          "unevaluatedProperties": false
        },
        "display": {
          "$ref": "#/$defs/Text"
        },
        "role": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "kind"
      ],
      "unevaluatedProperties": false
    },
    "ActorRef": {
      "title": "PBDL ActorRef",
      "oneOf": [
        {
          "$ref": "#/$defs/SubjectRef"
        },
        {
          "$ref": "#/$defs/ExternalActorRef"
        }
      ]
    }
  }
}
